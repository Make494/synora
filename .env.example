# Copy to .env and set a unique random secret before deploying.
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
FLASK_DEBUG=false
COOKIE_SECURE=false
PORT=5000
RESEARCH_MODEL_PATH=

# Keep Firebase disabled unless credentials, consent handling, and deletion
# procedures have been configured. Set true to use Application Default Credentials.
FIREBASE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# Optional API CORS origins, separated by commas.
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
